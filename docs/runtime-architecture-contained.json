  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime path",
      "items": [
        "main.tsx mounts App under React StrictMode",
        "App composes the error boundary, i18n provider, and RouterProvider",
        "Routes select public scenes, free or guided modes, and optional tasks"
      ]
    },
    {
      "dot": "emerald",
      "title": "Canonical learning loop",
      "items": [
        "appStore owns camera, movement, focus, aperture, calibration, and lesson state",
        "Optics derive planes, projections, and scene geometry from canonical state",
        "3D subjects, 2D diagrams, and Ground Glass RTT consume shared derived output"
      ]
    },
    {
      "dot": "rose",
      "title": "Boundary + dependencies",
      "items": [
        "Application code runs in the browser; the repository defines no accounts or persistence layer",
        "React Router, i18next, and Three.js/R3F/Drei are imported package dependencies",
        "Guided tasks inspect public scene metadata and task constraints without owning simulator state"
      ]
    }
  ]
