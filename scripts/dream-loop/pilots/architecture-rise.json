{
  "pilotId": "architecture-rise",
  "sceneId": "architecture-rise",
  "assetKey": "architecture-rise-subject",
  "implementationPath": "src/render/ArchitectureRiseSubjectFactory.tsx",
  "optimizationSurface": {
    "id": "observer-scene-viewport",
    "route": "/simulator/free/architecture-rise",
    "sceneSelector": "[data-testid=\"scene-canvas\"]",
    "canvasSelector": "canvas"
  },
  "writeScope": {
    "allowedPaths": [
      "src/render/ArchitectureRiseSubjectFactory.tsx",
      ".dream-loop/**"
    ],
    "protectedPaths": [
      "src/core/**",
      "src/app/**",
      "src/components/**",
      "src/state/**",
      "src/scenes/**",
      "public/**",
      "src/render/backend/**",
      "src/render/GroundGlassRTT.tsx",
      "src/render/groundGlass*",
      "src/render/GroundGlass*",
      "src/render/TeachingLighting.tsx",
      "src/render/assets/sceneAssetRegistry.ts",
      "src/render/SceneAssetSubjects.tsx",
      "src/render/sceneSubjectRegistry.tsx",
      "src/app/publicScenes.ts",
      "src/components/simulator/**",
      "src/render/SceneRenderer.tsx"
    ]
  },
  "verificationViews": [
    { "id": "observer", "role": "optimization-target" },
    { "id": "ground-glass-raw", "role": "regression-only" },
    { "id": "ground-glass-upright", "role": "regression-only" }
  ],
  "capture": {
    "viewport": { "width": 1440, "height": 1000 },
    "deviceScaleFactor": 1,
    "renderQuality": "standard",
    "outputPath": ".dream-loop/architecture-rise/observer-clean.png",
    "teachingOutputPath": ".dream-loop/architecture-rise/observer-teaching.png"
  }
}
